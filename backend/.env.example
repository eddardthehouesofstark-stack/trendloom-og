# Application
APP_NAME=TrendLoom
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./trendloom.db
# For Supabase PostgreSQL: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# API Keys (Optional - all features work without these)
HUGGINGFACE_API_KEY=

# Scheduler
SCHEDULER_ENABLED=True
DATA_COLLECTION_INTERVAL_HOURS=6

# Region
DEFAULT_STATE=Tamil Nadu
DEFAULT_COUNTRY=India

# Scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# AI Models
MODEL_CACHE_DIR=./models_cache
USE_GPU=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trendloom.log

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Cache TTL (seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600
